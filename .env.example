# ---------------------------------------------------------------------------
# Copy to .env and replace every value. Never commit real credentials.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL 16+ (docker compose, managed server, or `npm run dev:db`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/obe?schema=public

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Comma-separated allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Seed credentials (development only)
SEED_ADMIN_EMAIL=admin@uiit.edu.pk
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_TUTOR_PASSWORD=Tutor123!
SEED_STUDENT_PASSWORD=Student123!

LOG_LEVEL=info
